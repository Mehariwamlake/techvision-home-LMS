# Frappe LMS URL
FRAPPE_URL=https://learn.techvision.edu.et

# Required: set a unique random secret of at least 32 characters in production.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional destination for instructor applications. Configure this to your existing
# instructor-application handler/webhook; no ERP or CRM is assumed by the website.
INSTRUCTOR_APPLICATION_WEBHOOK_URL=
